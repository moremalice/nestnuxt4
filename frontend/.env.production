# ======== APPLICATION ENVIRONMENT ========
NUXT_PUBLIC_APP_ENV=production

# ======== SITE URLS ========
# Server-side site URL (for SEO, sitemap, robots)
NUXT_SITE_URL=https://pikitalk.com
# Client-side site URL (for proxy routes)
NUXT_PUBLIC_SITE_URL=https://pikitalk.com

# ======== API CONFIGURATION ========
# Public (클라이언트 노출) - 프록시 경로만
NUXT_PUBLIC_API_BASE=/api/nestjs

# Private (서버 전용) - 실제 백엔드 URL
NUXT_BACKEND_BASE_URL=https://api.pikitalk.com

# Public (클라이언트 노출) - CDN/정적 리소스 URL
NUXT_PUBLIC_CDN_BASE=https://pikitalk.com

# ======== RECAPTCHA CONFIGURATION ========
# Client-side keys (public) - Replace with actual production keys
NUXT_PUBLIC_RECAPTCHA_SITE_KEY=6LfrB8crAAAAAFMtY_AC9XaAsX40YNG_Bp3trqnR

# ======== BUILD CONFIGURATION ========
# Build ID for consistent file naming across multiple servers (will be overridden by CI/CD)
NUXT_BUILD_ID=prod

# ======== SITEMAP CONFIGURATION ========
# Disable sitemap preview in production for security
NUXT_SITEMAP_PREVIEW=0
