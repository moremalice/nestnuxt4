# ======== APPLICATION ENVIRONMENT ========
NUXT_PUBLIC_APP_ENV=production

# ======== SITE URLS ========
# Site URL components (for SEO, meta tags, canonical URL, sitemap, robots)
NUXT_PUBLIC_SITE_PROTOCOL=https
NUXT_PUBLIC_SITE_HOST=pikitalk.com
NUXT_PUBLIC_SITE_PORT=

# ======== API CONFIGURATION ========
# Public (클라이언트 노출) - 프록시 경로만
NUXT_PUBLIC_API_BASE=/api

# Private (서버 전용) - 실제 백엔드 URL 구성 요소
# Apache 리버스 프록시 환경: Nuxt 서버에서 내부 localhost로 Backend 호출
NUXT_BACKEND_PROTOCOL=http
NUXT_BACKEND_HOST=localhost
NUXT_BACKEND_PORT=3020

# Public (클라이언트 노출) - CDN/정적 리소스 URL
NUXT_PUBLIC_CDN_BASE=https://pikitalk.com

# ======== RECAPTCHA CONFIGURATION ========
# Client-side keys (public) - Replace with actual production keys
NUXT_PUBLIC_RECAPTCHA_SITE_KEY=6LfrB8crAAAAAFMtY_AC9XaAsX40YNG_Bp3trqnR

# ======== SITEMAP CONFIGURATION ========
# Disable sitemap preview in production for security
NUXT_SITEMAP_PREVIEW=0
