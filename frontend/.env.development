# ======== APPLICATION ENVIRONMENT ========
NUXT_PUBLIC_APP_ENV=development

# ======== SITE URLS ========
# Site URL components (for SEO, meta tags, canonical URL, sitemap, robots)
NUXT_PUBLIC_SITE_PROTOCOL=http
NUXT_PUBLIC_SITE_HOST=localhost
NUXT_PUBLIC_SITE_PORT=3000

# ======== API CONFIGURATION ========
# Public (클라이언트 노출) - 프록시 경로만
NUXT_PUBLIC_API_BASE=/api

# Private (서버 전용) - 실제 백엔드 URL 구성 요소
NUXT_BACKEND_PROTOCOL=http
NUXT_BACKEND_HOST=localhost
NUXT_BACKEND_PORT=3020

# ======== CDN CONFIGURATION ========
# Public (클라이언트 노출) - CDN/정적 리소스 URL (개발용 프록시)
NUXT_PUBLIC_CDN_BASE=https://pikitalk.com

# ======== RECAPTCHA CONFIGURATION ========
# Client-side keys (public) - Replace with actual development keys
NUXT_PUBLIC_RECAPTCHA_SITE_KEY=6LfrB8crAAAAAFMtY_AC9XaAsX40YNG_Bp3trqnR

# ======== SITEMAP CONFIGURATION ========
# Disable sitemap preview in development for security (can be enabled temporarily for testing)
NUXT_SITEMAP_PREVIEW=0