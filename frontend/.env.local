# ======== APPLICATION ENVIRONMENT ========
NUXT_PUBLIC_APP_ENV=local

# ======== SITE URLS ========
# Site URL (for SEO, meta tags, canonical URL, sitemap, robots)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ======== API CONFIGURATION ========
# Public (클라이언트 노출) - 프록시 경로만
NUXT_PUBLIC_API_BASE=/api/nestjs

# Private (서버 전용) - 실제 백엔드 URL
NUXT_BACKEND_BASE_URL=http://localhost:3020

# ======== CDN CONFIGURATION ========
# Public (클라이언트 노출) - CDN/정적 리소스 URL (로컬 개발용 프록시)
NUXT_PUBLIC_CDN_BASE=https://pikitalk.com

# ======== RECAPTCHA CONFIGURATION ========
# Client-side keys (public)
NUXT_PUBLIC_RECAPTCHA_SITE_KEY=6LfrB8crAAAAAFMtY_AC9XaAsX40YNG_Bp3trqnR

# ======== SITEMAP CONFIGURATION ========
# Enable sitemap preview in development (shows all URLs despite robots restrictions)
NUXT_SITEMAP_PREVIEW=1